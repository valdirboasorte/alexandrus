{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandrus-servidor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "ratelimits": [{ "name": "ROOM_CREATE", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "https://alexandrus.vercel.app",
    "STUN_URLS": "stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478",
    "MAX_VIEWERS": "12"
  }
}
